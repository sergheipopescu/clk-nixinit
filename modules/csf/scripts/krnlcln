#!/bin/bash -e
#
# clk-nixinit :: krnlcln
# Lists and purges superseded kernel packages -- image, headers and modules --
# keeping the running kernel and the newest installed one (kept even when it
# is not the running kernel yet, e.g. right after an upgrade but before a
# reboot).
#
# usage: krnlcln [exec]

echo

running=$(uname -r)								# currently booted kernel
echo "Running kernel: $running"

# every fully installed kernel image, oldest to newest. dpkg -l's first column
# is "ii" only for a package that is actually installed -- get-selections'
# "install" state just means desired-present, which also matches "deinstall"
# as a substring, and never reflects an old-but-still-installed kernel anyway
mapfile -t installed < <(dpkg -l 'linux-image-[0-9]*' 2>/dev/null | awk '/^ii/{print $2}' | sed 's/^linux-image-//' | sort -V)

echo
echo "Installed kernels:"
printf '  %s\n' "${installed[@]}"

if [ "${#installed[@]}" -eq 0 ]; then
	echo
	echo "Nothing to do."
	exit 0
fi

newest=${installed[-1]}							# keep even if not running yet

old=()
for kver in "${installed[@]}"; do

	[ "$kver" = "$running" ] && continue					# never the one we are booted into
	[ "$kver" = "$newest" ] && continue					# never the newest, booted or not
	old+=("$kver")
done

echo
if [ "${#old[@]}" -eq 0 ]; then

	echo "No old kernels to remove."
	exit 0
fi

# build the candidate package list, then keep only what is actually installed
# -- not every kernel has a modules-extra package, and passing a name apt
# does not recognize aborts the whole purge
candidates=()
for kver in "${old[@]}"; do
	candidates+=("linux-image-$kver" "linux-headers-$kver" "linux-modules-$kver" "linux-modules-extra-$kver")
done

mapfile -t pkgs < <(dpkg-query -W -f='${Package}\n' "${candidates[@]}" 2>/dev/null)

echo "Old kernels to be removed:"
printf '  %s\n' "${old[@]}"
echo
echo "Packages to be purged:"
printf '  %s\n' "${pkgs[@]}"

if [ "$1" == "exec" ]; then

	echo
	apt-get purge "${pkgs[@]}"
fi
